{
  "name": "citypark-exclusive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/copy-assets.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.cjs",
    "db:start": "supabase start --network-id citypark-exclusive-local",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:seed-local": "node scripts/seed-local.mjs",
    "test:access-local": "node scripts/test-access-local.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0"
  },
  "devDependencies": {
    "supabase": "2.117.0",
    "vite": "8.3.0"
  }
}
